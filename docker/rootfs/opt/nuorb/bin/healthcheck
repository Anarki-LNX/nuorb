#!/bin/sh
# Gesund = Oberfläche und Admin antworten. (Spracherkennung/Gehirn zählen nicht: Modelle laden beim ersten Start noch.)
# Ungesund auch, wenn die Gateway-Prüfung den Start von Hermes verweigert hat (config.yaml oder Policy-Hooks, v0.7.4).
if [ -s /run/nuorb-guard/blocked ]; then echo "hermes gateway blocked: $(head -c 300 /run/nuorb-guard/blocked)"; exit 1; fi
case "${NUORB_TLS:-selfsigned}" in off) S=http ;; *) S=https ;; esac
curl -fsk -m 4 -o /dev/null "$S://127.0.0.1:${UI_PORT:-8443}/api/info" || exit 1
curl -fsk -m 4 -o /dev/null "$S://127.0.0.1:${ADMIN_PORT:-8444}/api/auth/state" || exit 1
